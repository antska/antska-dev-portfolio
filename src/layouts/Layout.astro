---
import { ClientRouter } from "astro:transitions";

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: "website" | "article";
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
}

const {
  title,
  description = "Senior Frontend Engineer specializing in React & TypeScript, with full-stack capabilities. Building scalable, performant web applications with modern JavaScript frameworks.",
  image = "/og-image.jpg",
  type = "website",
  publishedTime,
  modifiedTime,
  author = "Antonis Skandalis",
} = Astro.props;

const siteUrl = Astro.site || "https://antska.dev";
const canonicalURL = new URL(Astro.url.pathname, siteUrl);
const ogImage = new URL(image, siteUrl).href;

// Structured Data (JSON-LD)
const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Antonis Skandalis",
  jobTitle: "Senior Frontend Engineer",
  url: siteUrl,
  sameAs: ["https://github.com/antska", "https://linkedin.com/in/antskandalis"],
  knowsAbout: [
    "React",
    "TypeScript",
    "Frontend Development",
    "Full-Stack Development",
    "Micro-frontends",
    "Design Systems",
    "Web development",
    "Web Performance",
  ],
  description: description,
};

const articleSchema =
  type === "article"
    ? {
        "@context": "https://schema.org",
        "@type": "BlogPosting",
        headline: title,
        description: description,
        author: {
          "@type": "Person",
          name: author,
        },
        publisher: {
          "@type": "Person",
          name: "Antonis Skandalis",
        },
        datePublished: publishedTime,
        dateModified: modifiedTime || publishedTime,
        mainEntityOfPage: {
          "@type": "WebPage",
          "@id": canonicalURL.href,
        },
      }
    : null;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalURL.href} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Fonts - Clean, minimal typography -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="antska.dev" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL.href} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:creator" content="@antska" />

    {
      publishedTime && (
        <meta property="article:published_time" content={publishedTime} />
      )
    }
    {
      modifiedTime && (
        <meta property="article:modified_time" content={modifiedTime} />
      )
    }
    {author && <meta property="article:author" content={author} />}

    <!-- Structured Data -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify(personSchema)}
    />
    {
      articleSchema && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(articleSchema)}
        />
      )
    }

    <title>{title}</title>

    <!-- Prevent flash of wrong theme -->
    <script is:inline>
      (function () {
        try {
          const stored = localStorage.getItem("theme");
          const prefersDark = window.matchMedia(
            "(prefers-color-scheme: dark)",
          ).matches;
          const dark = stored === "dark" || (!stored && prefersDark);
          if (dark) document.documentElement.classList.add("dark");
          else document.documentElement.classList.remove("dark");
        } catch (e) {}
      })();

      function applyTheme() {
        try {
          const stored = localStorage.getItem("theme");
          const prefersDark = window.matchMedia(
            "(prefers-color-scheme: dark)",
          ).matches;
          const dark = stored === "dark" || (!stored && prefersDark);
          if (dark) document.documentElement.classList.add("dark");
          else document.documentElement.classList.remove("dark");
        } catch (e) {}
      }
      // Re-apply theme after View Transitions swap or page load
      document.addEventListener("astro:after-swap", applyTheme);
      document.addEventListener("astro:page-load", applyTheme);
    </script>

    <!-- View Transitions (Astro 5+) -->
    <ClientRouter />
  </head>
  <body
    class="min-h-screen bg-neutral-50 text-neutral-800 font-sans antialiased dark:bg-neutral-900 dark:text-neutral-200"
  >
    <slot />

    <!-- Theme toggle: event delegation so it works with multiple buttons and View Transitions -->
    <script is:inline>
      (function () {
        var KEY = "theme";
        var DARK = "dark";
        var LIGHT = "light";
        function setStored(value) {
          try {
            localStorage.setItem(KEY, value);
          } catch (e) {}
        }
        function apply(value) {
          var root = document.documentElement;
          if (value === DARK) root.classList.add(DARK);
          else root.classList.remove(DARK);
          setStored(value);
        }
        function handleToggle() {
          var isDark = document.documentElement.classList.contains(DARK);
          apply(isDark ? LIGHT : DARK);
        }
        document.addEventListener("click", function (e) {
          if (
            e.target &&
            e.target.closest &&
            e.target.closest(".theme-toggle-btn")
          ) {
            e.preventDefault();
            handleToggle();
          }
        });
      })();
    </script>
  </body>
</html>

<style is:global>
  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    scroll-behavior: smooth;
  }

  ::selection {
    background-color: rgba(0, 0, 0, 0.08);
    color: inherit;
  }

  body {
    font-family: "Space Grotesk", system-ui, sans-serif;
  }

  h1,
  h2,
  h3,
  h4,
  h5,
  h6 {
    font-family: "Space Grotesk", system-ui, sans-serif;
    font-weight: 600;
  }

  /* View Transitions - Minimal fade */
  ::view-transition-old(root),
  ::view-transition-new(root) {
    animation-duration: 0.25s;
    animation-timing-function: ease-out;
  }

  @keyframes minimal-fade-out {
    from {
      opacity: 1;
    }
    to {
      opacity: 0;
    }
  }

  @keyframes minimal-fade-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  ::view-transition-old(root) {
    animation-name: minimal-fade-out;
  }

  ::view-transition-new(root) {
    animation-name: minimal-fade-in;
  }

  /* Header persistent transition - no animation */
  ::view-transition-old(header),
  ::view-transition-new(header) {
    animation: none;
    mix-blend-mode: normal;
    height: auto;
    right: 0;
    left: 0;
    transform: none;
  }

  /* Smooth scroll restoration */
  html {
    view-transition-name: root;
  }

  /* Prevent flash of unstyled content during transition */
  [data-astro-transition-scope] {
    view-transition-name: root;
  }

  /* Header persistent transition */
  header[data-transition-name="header"] {
    view-transition-name: header;
  }

  /* Transition group container */
  ::view-transition-group(root) {
    animation-duration: 0.4s;
  }

  @keyframes minimal-load-bar {
    0% {
      transform: scaleX(0);
      transform-origin: left;
    }
    100% {
      transform: scaleX(1);
      transform-origin: left;
    }
  }

  html[data-transitioning]::after {
    content: "";
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 2px;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(0, 0, 0, 0.15),
      transparent
    );
    z-index: 10000;
    pointer-events: none;
    animation: minimal-load-bar 0.25s ease-out;
  }
</style>

<script>
  // Set up header for persistent transition
  document.addEventListener("DOMContentLoaded", () => {
    const header = document.querySelector(
      'header[data-transition-name="header"]',
    );
    if (header) {
      header.style.viewTransitionName = "header";
    }
  });

  // Handle page transitions - add loading indicator
  document.addEventListener("astro:before-preparation", () => {
    document.documentElement.setAttribute("data-transitioning", "true");
  });

  // Clean up after page load
  document.addEventListener("astro:page-load", () => {
    // Scroll to top on new page load (instant, no smooth scroll during transition)
    window.scrollTo({ top: 0, behavior: "instant" });

    // Update header transition name for persistence
    const header = document.querySelector(
      'header[data-transition-name="header"]',
    );
    if (header) {
      header.style.viewTransitionName = "header";
    }

    // Remove transitioning attribute after transition completes
    setTimeout(() => {
      document.documentElement.removeAttribute("data-transitioning");
    }, 250);
  });
</script>
