---
interface Props {
  primaryLabel?: string;
  primaryHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
}

const {
  primaryLabel = "Get in Touch",
  primaryHref = "/contact",
  secondaryLabel = "View Projects",
  secondaryHref = "/projects",
} = Astro.props;
---

<div class="flex gap-3 justify-center items-center flex-wrap">
  <a
    href={primaryHref}
    class="inline-flex items-center gap-2 px-6 py-3 bg-accent-600 text-white text-sm font-semibold rounded-xl shadow-accent hover:bg-accent-700 transition-colors ring-2 ring-accent-600/30 ring-offset-2 ring-offset-transparent dark:ring-offset-neutral-900"
    tabindex="0"
    aria-label={primaryLabel}
  >
    {primaryLabel}
    <svg
      class="w-4 h-4"
      fill="none"
      stroke="currentColor"
      viewBox="0 0 24 24"
      aria-hidden="true"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
    </svg>
  </a>
  <a
    href={secondaryHref}
    class="inline-flex items-center gap-2 px-6 py-3 bg-neutral-800 text-white text-sm font-medium rounded-xl shadow-soft hover:bg-neutral-700 transition-colors"
    tabindex="0"
    aria-label={secondaryLabel}
  >
    {secondaryLabel}
    <svg
      class="w-4 h-4"
      fill="none"
      stroke="currentColor"
      viewBox="0 0 24 24"
      aria-hidden="true"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
    </svg>
  </a>
</div>
