---
interface Props {
  show?: boolean;
}

const { show = true } = Astro.props;
---

{show && (
  <div class="inline-flex items-center gap-2 px-6 py-3 bg-neutral-900 text-white border-4 border-black shadow-brutal-md mb-8 transform -rotate-1">
    <span class="relative flex h-2 w-2">
      <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75" />
      <span class="relative inline-flex rounded-full h-2 w-2 bg-green-500" />
    </span>
    <span class="font-bold uppercase text-sm">Available for freelance</span>
  </div>
)}
