---
interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
const currentYear = new Date().getFullYear();
---

<footer
  class:list={[
    "border-t border-neutral-200/80 dark:border-neutral-700/80 bg-neutral-100 dark:bg-neutral-800/50 flex-shrink-0",
    compact ? "py-3 px-4" : "py-12 px-6",
  ]}
>
  <div class={compact ? "max-w-7xl mx-auto" : "max-w-7xl mx-auto px-6"}>
    <div
      class={`flex flex-col md:flex-row items-center justify-between ${compact ? "gap-3" : "gap-6"}`}
    >
      <div
        class={`flex flex-col sm:flex-row items-center ${compact ? "gap-2 sm:gap-3" : "gap-4 sm:gap-6"}`}
      >
        <p
          class={compact
            ? "text-xs text-neutral-500 dark:text-neutral-400"
            : "text-sm text-neutral-500 dark:text-neutral-400"}
        >
          © {currentYear} Antonis Skandalis
        </p>
        <div
          class:list={[
            "inline-flex items-center gap-2 bg-white/80 dark:bg-neutral-800/80 border border-neutral-200/80 dark:border-neutral-600/50 rounded-full shadow-soft text-neutral-600 dark:text-neutral-300",
            compact ? "px-2.5 py-1 text-xs" : "px-4 py-2 text-sm",
          ]}
        >
          <span class="relative flex h-1.5 w-1.5">
            <span
              class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"
            ></span>
            <span
              class="relative inline-flex rounded-full h-1.5 w-1.5 bg-emerald-500"
            ></span>
          </span>
          Available for new projects
        </div>
      </div>

      <div class={`flex ${compact ? "gap-1" : "gap-2"}`}>
        <a
          href="https://github.com/antska"
          target="_blank"
          rel="noopener noreferrer"
          class={`rounded-lg text-neutral-400 dark:text-neutral-500 hover:text-neutral-700 dark:hover:text-neutral-200 hover:bg-white/60 dark:hover:bg-neutral-700/60 transition-colors ${compact ? "p-1.5" : "p-2.5"}`}
          aria-label="Visit GitHub profile"
          tabindex="0"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path
              d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"
            ></path>
          </svg>
        </a>
        <a
          href="https://linkedin.com/in/antskandalis"
          target="_blank"
          rel="noopener noreferrer"
          class={`rounded-lg text-neutral-400 dark:text-neutral-500 hover:text-neutral-700 dark:hover:text-neutral-200 hover:bg-white/60 dark:hover:bg-neutral-700/60 transition-colors ${compact ? "p-1.5" : "p-2.5"}`}
          aria-label="Visit LinkedIn profile"
          tabindex="0"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path
              d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
            ></path>
          </svg>
        </a>
        <a
          href="mailto:ant.skandalis@gmail.com"
          class={`rounded-lg text-neutral-400 dark:text-neutral-500 hover:text-neutral-700 dark:hover:text-neutral-200 hover:bg-white/60 dark:hover:bg-neutral-700/60 transition-colors ${compact ? "p-1.5" : "p-2.5"}`}
          aria-label="Send email"
          tabindex="0"
        >
          <svg
            class="w-5 h-5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
            ></path>
          </svg>
        </a>
      </div>
    </div>
  </div>
</footer>
