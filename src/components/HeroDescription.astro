---
import { HERO_DESCRIPTION } from "../lib/constants";

interface Props {
  text?: string;
  className?: string;
}

const { text = HERO_DESCRIPTION, className = "" } = Astro.props;
---

<p
  class={`text-base sm:text-lg font-normal mb-4 sm:mb-6 max-w-2xl mx-auto leading-relaxed text-neutral-600 dark:text-neutral-400 ${className}`}
>
  {text}
</p>
