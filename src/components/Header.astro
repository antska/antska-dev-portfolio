---
interface NavLink {
  label: string;
  href: string;
}

const navLinks: NavLink[] = [
  { label: 'Home', href: '/' },
  { label: 'About', href: '/about' },
  { label: 'Projects', href: '/projects' },
  { label: 'Blog', href: '/blog' },
  { label: 'Contact', href: '/contact' },
];

const currentPath = Astro.url.pathname;

const isActive = (href: string): boolean => {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
};
---

<header class="sticky top-0 bg-white border-b-4 border-black z-50" data-transition-name="header">
  <nav class="max-w-7xl mx-auto px-4 sm:px-6 py-4 flex justify-between items-center">
    <!-- Logo -->
    <a
      href="/"
      class="text-2xl font-display font-black uppercase tracking-tight bg-black text-white px-4 py-2 transform -rotate-1 hover:rotate-0 transition-transform"
      aria-label="Go to homepage"
      tabindex="0"
    >
      antska.dev
    </a>
    
    <!-- Desktop Navigation -->
    <div class="hidden md:flex gap-2">
      {navLinks.map((link) => (
        <a 
          href={link.href}
          class={`px-4 py-2 font-bold uppercase text-sm border-2 border-black transition-all hover:translate-x-1 hover:translate-y-1 hover:shadow-none ${
            isActive(link.href) 
              ? 'bg-neutral-900 text-white shadow-brutal' 
              : 'bg-white shadow-brutal'
          }`}
          aria-current={isActive(link.href) ? 'page' : undefined}
          tabindex="0"
        >
          {link.label}
        </a>
      ))}
    </div>

    <!-- Mobile Menu Button -->
    <button 
      type="button"
      id="mobile-menu-btn"
      class="md:hidden p-2 border-2 border-black bg-white shadow-brutal active:translate-x-1 active:translate-y-1 active:shadow-none"
      aria-label="Toggle mobile menu"
      aria-expanded="false"
      tabindex="0"
    >
      <svg id="menu-icon" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
      <svg id="close-icon" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </nav>

  <!-- Mobile Navigation -->
  <div id="mobile-menu" class="hidden md:hidden bg-neutral-100 border-t-4 border-black">
    {navLinks.map((link) => (
      <a 
        href={link.href}
        class="block w-full text-left px-6 py-4 font-bold border-b-2 border-black hover:bg-neutral-200 transition-colors uppercase"
        aria-current={isActive(link.href) ? 'page' : undefined}
        tabindex="0"
      >
        {link.label}
      </a>
    ))}
  </div>
</header>

<script>
  const mobileMenuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const menuIcon = document.getElementById('menu-icon');
  const closeIcon = document.getElementById('close-icon');

  const handleToggleMenu = () => {
    const isExpanded = mobileMenuBtn?.getAttribute('aria-expanded') === 'true';
    mobileMenuBtn?.setAttribute('aria-expanded', (!isExpanded).toString());
    mobileMenu?.classList.toggle('hidden');
    menuIcon?.classList.toggle('hidden');
    closeIcon?.classList.toggle('hidden');
  };

  mobileMenuBtn?.addEventListener('click', handleToggleMenu);
  mobileMenuBtn?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' || e.key === ' ') {
      e.preventDefault();
      handleToggleMenu();
    }
  });
</script>
