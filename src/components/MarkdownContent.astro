---
interface Props {
  content: string;
  className?: string;
  architectureImage?: string;
  architectureImageAlt?: string;
  architectureImageCaption?: string;
}

const {
  content,
  className = "",
  architectureImage,
  architectureImageAlt,
  architectureImageCaption,
} = Astro.props;

if (!content) {
  return null;
}

// Enhanced markdown to HTML converter
const markdownToHtml = (markdown: string): string => {
  // Normalize line endings
  let normalized = markdown.replace(/\r\n/g, "\n").replace(/\r/g, "\n");

  // Strip YAML frontmatter if present (lines starting with ---)
  // Matches: ---\n...content...\n---\n or ---\r\n...content...\r\n---\r\n
  const frontmatterRegex = /^---\s*[\r\n]+([\s\S]*?)[\r\n]+---\s*[\r\n]*/;
  if (frontmatterRegex.test(normalized)) {
    normalized = normalized.replace(frontmatterRegex, "");
  }

  // Trim leading/trailing whitespace
  normalized = normalized.trim();

  // Step 1: Extract and protect code blocks first
  const codeBlocks: string[] = [];
  let html = normalized.replace(
    /```(\w+)?\n([\s\S]*?)```/g,
    (match, lang, code) => {
      const language = (lang || "text").trim();
      // Don't trim code - preserve formatting, but remove trailing newline if present
      const escapedCode = code
        .replace(/\n$/, "") // Remove trailing newline only
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");
      const placeholder = `__CODE_BLOCK_${codeBlocks.length}__`;
      codeBlocks.push(
        `<pre class="bg-neutral-900 text-white border-4 border-black p-6 overflow-x-auto my-6"><code class="language-${language}">${escapedCode}</code></pre>`,
      );
      return placeholder;
    },
  );

  // Step 2: Process block-level elements line by line
  const lines = html.split("\n");
  const processedBlocks: string[] = [];
  let currentList: string[] = [];
  let inList = false;
  let listType: "ul" | "ol" = "ul";

  const escapeHtml = (text: string): string => {
    return text
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#039;");
  };

  const processInline = (text: string): string => {
    // First, escape HTML to prevent XSS
    text = escapeHtml(text);

    // Inline code (protect from other processing)
    const inlineCodeBlocks: string[] = [];
    text = text.replace(/`([^`]+)`/g, (match, code) => {
      const placeholder = `__INLINE_CODE_${inlineCodeBlocks.length}__`;
      // Code is already escaped by escapeHtml above
      inlineCodeBlocks.push(
        `<code class="bg-neutral-100 px-2 py-1 border border-black font-mono text-sm">${code}</code>`,
      );
      return placeholder;
    });

    // Links (process before bold/italic to avoid conflicts)
    text = text.replace(/\[([^\]]+)\]\(([^)]+)\)/g, (match, linkText, url) => {
      // URL should be escaped for safety
      const safeUrl = escapeHtml(url);
      return `<a href="${safeUrl}" class="text-neutral-900 underline font-bold hover:text-neutral-600" target="_blank" rel="noopener noreferrer">${linkText}</a>`;
    });

    // Bold (**text** or __text__) - must come after link processing
    text = text.replace(/\*\*([^*]+)\*\*/g, "<strong>$1</strong>");
    text = text.replace(/__([^_]+)__/g, "<strong>$1</strong>");

    // Italic (*text* or _text_) - be careful not to match bold
    text = text.replace(/(?<!\*)\*([^*\n]+?)\*(?!\*)/g, "<em>$1</em>");
    text = text.replace(/(?<!_)_([^_\n]+?)_(?!_)/g, "<em>$1</em>");

    // Restore inline code
    inlineCodeBlocks.forEach((code, idx) => {
      text = text.replace(`__INLINE_CODE_${idx}__`, code);
    });

    return text;
  };

  let previousWasEmpty = false;
  lines.forEach((line, index) => {
    const trimmed = line.trim();

    // Handle empty lines - they separate paragraphs
    if (!trimmed) {
      if (inList) {
        processedBlocks.push(
          `<${listType} class="list-disc space-y-2 my-4 ml-6">${currentList.join("")}</${listType}>`,
        );
        currentList = [];
        inList = false;
      }
      // Mark that we had an empty line (will be used to separate paragraphs)
      if (!previousWasEmpty) {
        processedBlocks.push("__PARAGRAPH_BREAK__");
        previousWasEmpty = true;
      }
      return;
    }
    previousWasEmpty = false;

    // Code block placeholder (restore later)
    if (trimmed.startsWith("__CODE_BLOCK_")) {
      if (inList) {
        processedBlocks.push(
          `<${listType} class="list-disc space-y-2 my-4 ml-6">${currentList.join("")}</${listType}>`,
        );
        currentList = [];
        inList = false;
      }
      processedBlocks.push(trimmed);
      return;
    }

    // Headers
    if (trimmed.startsWith("### ")) {
      if (inList) {
        processedBlocks.push(
          `<${listType} class="list-disc space-y-2 my-4 ml-6">${currentList.join("")}</${listType}>`,
        );
        currentList = [];
        inList = false;
      }
      const text = processInline(trimmed.substring(4));
      processedBlocks.push(
        `<h3 class="text-xl font-display font-black uppercase mb-3 mt-6">${text}</h3>`,
      );
      return;
    }
    if (trimmed.startsWith("## ")) {
      if (inList) {
        processedBlocks.push(
          `<${listType} class="list-disc space-y-2 my-4 ml-6">${currentList.join("")}</${listType}>`,
        );
        currentList = [];
        inList = false;
      }
      const text = processInline(trimmed.substring(3));
      processedBlocks.push(
        `<h2 class="text-2xl font-display font-black uppercase mb-4 mt-8">${text}</h2>`,
      );
      return;
    }
    if (trimmed.startsWith("# ")) {
      if (inList) {
        processedBlocks.push(
          `<${listType} class="list-disc space-y-2 my-4 ml-6">${currentList.join("")}</${listType}>`,
        );
        currentList = [];
        inList = false;
      }
      const text = processInline(trimmed.substring(2));
      processedBlocks.push(
        `<h1 class="text-3xl font-display font-black uppercase mb-6 mt-10">${text}</h1>`,
      );
      return;
    }

    // Horizontal rule
    if (trimmed === "---" || trimmed === "***") {
      if (inList) {
        processedBlocks.push(
          `<${listType} class="list-disc space-y-2 my-4 ml-6">${currentList.join("")}</${listType}>`,
        );
        currentList = [];
        inList = false;
      }
      processedBlocks.push('<hr class="my-8 border-t-4 border-black">');
      return;
    }

    // Blockquote
    if (trimmed.startsWith("> ")) {
      if (inList) {
        processedBlocks.push(
          `<${listType} class="list-disc space-y-2 my-4 ml-6">${currentList.join("")}</${listType}>`,
        );
        currentList = [];
        inList = false;
      }
      const text = processInline(trimmed.substring(2));
      processedBlocks.push(
        `<blockquote class="border-l-4 border-black pl-4 italic text-neutral-700 my-4">${text}</blockquote>`,
      );
      return;
    }

    // Unordered list
    const ulMatch = trimmed.match(/^[\*\-\+] (.+)$/);
    if (ulMatch) {
      if (!inList || listType !== "ul") {
        if (inList) {
          processedBlocks.push(
            `<${listType} class="list-disc space-y-2 my-4 ml-6">${currentList.join("")}</${listType}>`,
          );
        }
        currentList = [];
        inList = true;
        listType = "ul";
      }
      const text = processInline(ulMatch[1]);
      currentList.push(`<li class="mb-2">${text}</li>`);
      return;
    }

    // Ordered list
    const olMatch = trimmed.match(/^\d+\. (.+)$/);
    if (olMatch) {
      if (!inList || listType !== "ol") {
        if (inList) {
          processedBlocks.push(
            `<${listType} class="list-disc space-y-2 my-4 ml-6">${currentList.join("")}</${listType}>`,
          );
        }
        currentList = [];
        inList = true;
        listType = "ol";
      }
      const text = processInline(olMatch[1]);
      currentList.push(`<li class="mb-2">${text}</li>`);
      return;
    }

    // Regular paragraph line
    if (inList) {
      processedBlocks.push(
        `<${listType} class="list-disc space-y-2 my-4 ml-6">${currentList.join("")}</${listType}>`,
      );
      currentList = [];
      inList = false;
    }

    // Store as paragraph (will be processed later)
    processedBlocks.push(trimmed);
  });

  // Close any remaining list
  if (inList && currentList.length > 0) {
    processedBlocks.push(
      `<${listType} class="list-disc space-y-2 my-4 ml-6">${currentList.join("")}</${listType}>`,
    );
  }

  // Step 3: Process paragraphs - group consecutive text lines into paragraphs
  const finalBlocks: string[] = [];
  let currentParagraph: string[] = [];

  processedBlocks.forEach((block) => {
    // Paragraph break marker
    if (block === "__PARAGRAPH_BREAK__") {
      // Flush current paragraph
      if (currentParagraph.length > 0) {
        const paraText = currentParagraph.join(" ");
        const processed = processInline(paraText);
        if (processed.trim()) {
          finalBlocks.push(
            `<p class="font-semibold leading-relaxed text-lg text-neutral-800 mb-4">${processed}</p>`,
          );
        }
        currentParagraph = [];
      }
      return;
    }

    // Already processed block elements
    if (block.startsWith("<") || block.startsWith("__CODE_BLOCK_")) {
      // Flush any accumulated paragraph
      if (currentParagraph.length > 0) {
        const paraText = currentParagraph.join(" ");
        const processed = processInline(paraText);
        if (processed.trim()) {
          finalBlocks.push(
            `<p class="font-semibold leading-relaxed text-lg text-neutral-800 mb-4">${processed}</p>`,
          );
        }
        currentParagraph = [];
      }
      finalBlocks.push(block);
    } else {
      // Accumulate text for paragraph (join with space)
      currentParagraph.push(block);
    }
  });

  // Flush remaining paragraph
  if (currentParagraph.length > 0) {
    const paraText = currentParagraph.join(" ");
    const processed = processInline(paraText);
    if (processed.trim()) {
      finalBlocks.push(
        `<p class="font-semibold leading-relaxed text-lg text-neutral-800 mb-4">${processed}</p>`,
      );
    }
  }

  html = finalBlocks.join("\n");

  // Step 4: Restore code blocks
  codeBlocks.forEach((codeBlock, index) => {
    html = html.replace(`__CODE_BLOCK_${index}__`, codeBlock);
  });

  // Step 5: Inject architecture image after "## The Architecture" heading if provided
  if (architectureImage) {
    const imageAlt = architectureImageAlt || "Architecture diagram";
    const imageCaption = architectureImageCaption || "";

    const imageHtml = `
      <div class="my-8">
        <img
          src="${architectureImage.replace(/"/g, "&quot;")}"
          alt="${imageAlt.replace(/"/g, "&quot;")}"
          class="w-full border-4 border-black shadow-brutal-md"
          loading="lazy"
        />
        ${imageCaption ? `<p class="mt-4 text-sm font-semibold text-neutral-600 text-center">${imageCaption.replace(/</g, "&lt;").replace(/>/g, "&gt;")}</p>` : ""}
      </div>
    `;

    // Find "## The Architecture" heading and insert image after it
    html = html.replace(
      /(<h2 class="text-2xl font-display font-black uppercase mb-4 mt-8">The Architecture<\/h2>)/,
      `$1${imageHtml}`,
    );
  }

  return html;
};

let htmlContent: string;
try {
  htmlContent = markdownToHtml(content);
} catch (error) {
  console.error("Error parsing markdown:", error);
  // Fallback: escape and display as plain text
  htmlContent = `<pre class="bg-red-50 border-4 border-red-500 p-4 text-sm">Error parsing markdown. Raw content:\n\n${content.replace(/</g, "&lt;").replace(/>/g, "&gt;")}</pre>`;
}
---

<div class={`space-y-6 ${className}`} set:html={htmlContent} />
