---
import AvailabilityBadge from "./AvailabilityBadge.astro";
import KeywordBackground from "./KeywordBackground.astro";
import HeroTitle from "./HeroTitle.astro";
import HeroDescription from "./HeroDescription.astro";
import HeroCTA from "./HeroCTA.astro";
import SocialLinks from "./SocialLinks.astro";
import {
  HERO_DESCRIPTION,
  HERO_TITLE,
  HERO_CTA,
  HERO_LOCATION,
} from "../lib/constants";

interface Props {
  showAvailableBadge?: boolean;
  title?: {
    primary?: string;
    secondary?: string;
  };
  description?: string;
  cta?: {
    primaryLabel?: string;
    primaryHref?: string;
    secondaryLabel?: string;
    secondaryHref?: string;
  };
}

const {
  showAvailableBadge = true,
  title = HERO_TITLE,
  description = HERO_DESCRIPTION,
  cta = HERO_CTA,
} = Astro.props;
---

<section
  class="min-h-0 flex flex-1 flex-col items-center justify-center bg-neutral-50 dark:bg-neutral-900 relative overflow-hidden py-4 sm:py-6"
>
  <KeywordBackground />

  <div class="max-w-5xl mx-auto px-6 text-center relative z-10 py-6 sm:py-10">
    <AvailabilityBadge show={showAvailableBadge} />

    <HeroTitle primaryText={title.primary} secondaryText={title.secondary} />

    <p
      class="text-sm font-medium uppercase tracking-widest text-neutral-500 dark:text-neutral-400 mb-4"
    >
      Web & App Developer · {HERO_LOCATION}
    </p>

    <HeroDescription text={description} />

    <HeroCTA
      primaryLabel={cta.primaryLabel}
      primaryHref={cta.primaryHref}
      secondaryLabel={cta.secondaryLabel}
      secondaryHref={cta.secondaryHref}
    />

    <SocialLinks className="mt-6 sm:mt-8" />
  </div>
</section>
