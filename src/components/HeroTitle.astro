---
interface Props {
  primaryText?: string;
  secondaryText?: string;
}

const { primaryText = "ANTONIS", secondaryText = "SKANDALIS" } = Astro.props;
---

<h1
  class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-semibold mb-2 sm:mb-4 leading-tight text-neutral-900 dark:text-neutral-100"
>
  {primaryText}
  <br />
  <span class="text-neutral-600 dark:text-neutral-400 font-normal">
    {secondaryText}
  </span>
</h1>
