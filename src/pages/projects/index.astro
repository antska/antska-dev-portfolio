---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { getCollection } from 'astro:content';
import {
  PAGE_TITLES,
  META_DESCRIPTIONS,
} from "../../lib/constants";

// Fetch projects from Content Collections
const projects = (await getCollection('projects')).sort((a, b) => {
  const dateA = typeof a.data.publishedAt === 'string' ? new Date(a.data.publishedAt) : a.data.publishedAt;
  const dateB = typeof b.data.publishedAt === 'string' ? new Date(b.data.publishedAt) : b.data.publishedAt;
  return dateB.getTime() - dateA.getTime();
});
---

<Layout title={PAGE_TITLES.projects} description={META_DESCRIPTIONS.projects}>
  <Header />
  <main>
    <section class="min-h-screen py-24 bg-neutral-50">
      <div class="max-w-7xl mx-auto px-6">
        <h1
          class="text-5xl md:text-6xl font-display font-black mb-16 text-center uppercase transform rotate-1"
        >
          <span
            class="bg-neutral-900 text-white border-4 border-black px-6 py-2 inline-block shadow-brutal-md"
          >
            Featured Projects
          </span>
        </h1>

        <div class="grid md:grid-cols-2 gap-8">
          {
            projects.map((project, idx) => (
              <article
                class={`bg-white border-4 border-black p-8 shadow-brutal-lg hover:translate-x-2 hover:translate-y-2 hover:shadow-none transition-all transform ${idx % 2 === 0 ? "rotate-1" : "-rotate-1"} group`}
              >
                <a
                  href={`/projects/${project.data.slug}`}
                  class="block"
                  tabindex="0"
                  aria-label={`View project: ${project.data.title}`}
                >
                  <div class="flex items-start justify-between mb-4">
                    <h2 class="text-2xl font-display font-black uppercase leading-tight flex-1 group-hover:underline decoration-4">
                      {project.data.title}
                    </h2>
                    <svg
                      class="w-6 h-6 flex-shrink-0"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                      />
                    </svg>
                  </div>

                  <p class="font-bold mb-6 text-lg text-neutral-700">
                    {project.data.description}
                  </p>

                  {project.data.tags && project.data.tags.length > 0 && (
                    <div class="flex flex-wrap gap-2 mb-6">
                      {project.data.tags.slice(0, 6).map((tag) => (
                        <span class="px-3 py-1 bg-neutral-100 border-2 border-black font-black text-xs uppercase">
                          {tag}
                        </span>
                      ))}
                    </div>
                  )}

                  {project.data.highlights && project.data.highlights.length > 0 && (
                    <ul class="space-y-2">
                      {project.data.highlights.slice(0, 3).map((highlight) => (
                        <li class="font-semibold flex items-center gap-2 text-neutral-700">
                          <span class="font-black mt-1">→</span>
                          {highlight}
                        </li>
                      ))}
                    </ul>
                  )}
                </a>
              </article>
            ))
          }
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
