---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { getCollection, render } from "astro:content";

export const getStaticPaths = async () => {
  const projects = await getCollection("projects");
  return projects.map((project) => ({
    params: {
      slug:
        project.data.slug ||
        project.id.split("/").pop()?.replace(".md", "") ||
        "",
    },
    props: { project },
  }));
};

interface Props {
  project: Awaited<ReturnType<typeof getCollection<"projects">>>[number];
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<Layout
  title={`${project.data.title} | Antonis Skandalis`}
  description={project.data.description}
>
  <Header />
  <main class="min-h-screen bg-neutral-50 dark:bg-neutral-900">
    <nav
      class="bg-neutral-50 dark:bg-neutral-900 border-b border-neutral-200/80 dark:border-neutral-700/80"
    >
      <div class="max-w-4xl mx-auto px-4 sm:px-6 py-4">
        <a
          href="/projects"
          class="inline-flex items-center gap-2 text-sm font-medium text-neutral-600 dark:text-neutral-400 hover:text-neutral-900 dark:hover:text-neutral-100 transition-colors"
          tabindex="0"
          aria-label="Back to projects"
        >
          <svg
            class="w-4 h-4"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
          </svg>
          Back to Projects
        </a>
      </div>
    </nav>

    <article class="max-w-4xl mx-auto px-6 py-16">
      <div class="mb-8">
        <h1
          class="text-2xl sm:text-3xl font-semibold text-neutral-900 dark:text-neutral-100 mb-6 leading-tight"
        >
          {project.data.title}
        </h1>

        <div class="flex flex-wrap gap-2 mb-6">
          {
            project.data.tags &&
              project.data.tags.map((tag) => (
                <span class="px-3 py-1.5 bg-neutral-50 dark:bg-neutral-700 border border-neutral-200 dark:border-neutral-600 rounded-lg font-medium text-xs text-neutral-600 dark:text-neutral-300">
                  {tag}
                </span>
              ))
          }
        </div>

        <p
          class="text-neutral-600 dark:text-neutral-400 text-base leading-relaxed border-l-2 border-neutral-200 dark:border-neutral-600 pl-4 mb-6"
        >
          {project.data.description}
        </p>

        {
          (project.data.liveUrl || project.data.githubUrl) && (
            <div class="flex flex-wrap gap-3 mb-6">
              {project.data.liveUrl && (
                <a
                  href={project.data.liveUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 px-5 py-2.5 bg-accent-600 text-white text-sm font-medium rounded-xl shadow-accent hover:bg-accent-700 transition-colors"
                  aria-label="Visit live site"
                >
                  <svg
                    class="w-5 h-5"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                    />
                  </svg>
                  Visit Live Site
                </a>
              )}
              {project.data.githubUrl && (
                <a
                  href={project.data.githubUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 px-5 py-2.5 bg-neutral-800 text-white text-sm font-medium rounded-xl shadow-soft hover:bg-neutral-700 transition-colors"
                  aria-label="View on GitHub"
                >
                  <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                    <path
                      fill-rule="evenodd"
                      d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
                      clip-rule="evenodd"
                    />
                  </svg>
                  View Code
                </a>
              )}
            </div>
          )
        }
      </div>

      {
        project.body && (
          <div class="bg-white dark:bg-neutral-800 rounded-2xl p-8 shadow-soft mb-8 border border-transparent dark:border-neutral-700">
            <h2 class="text-lg font-semibold text-neutral-900 dark:text-neutral-100 mb-6">
              Project Details
            </h2>
            <article class="prose prose-neutral dark:prose-invert prose-lg max-w-none space-y-6 [&_pre]:bg-neutral-100 dark:[&_pre]:bg-neutral-700 [&_pre]:text-neutral-800 dark:[&_pre]:text-neutral-200 [&_pre]:border [&_pre]:border-neutral-200 dark:[&_pre]:border-neutral-600 [&_pre]:rounded-lg [&_pre]:p-6 [&_pre]:overflow-x-auto [&_pre]:my-6 [&_code]:bg-neutral-100 dark:[&_code]:bg-neutral-700 [&_code]:px-1.5 [&_code]:py-0.5 [&_code]:rounded [&_code]:font-mono [&_code]:text-sm [&_img]:rounded-lg [&_img]:border [&_img]:border-neutral-200 dark:[&_img]:border-neutral-600">
              <Content />
            </article>
          </div>
        )
      }

      {
        project.data.highlights && project.data.highlights.length > 0 && (
          <div class="bg-white dark:bg-neutral-800 rounded-2xl p-8 shadow-soft border border-transparent dark:border-neutral-700">
            <h2 class="text-lg font-semibold text-neutral-900 dark:text-neutral-100 mb-6">
              Key Achievements
            </h2>
            <ul class="space-y-3">
              {project.data.highlights.map((highlight) => (
                <li class="text-sm flex items-start gap-3 text-neutral-600 dark:text-neutral-400">
                  <span class="text-neutral-400 dark:text-neutral-500 mt-0.5">
                    →
                  </span>
                  {highlight}
                </li>
              ))}
            </ul>
          </div>
        )
      }

      <div class="mt-12 flex flex-col sm:flex-row gap-3 justify-center">
        <a
          href="/projects"
          class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-neutral-800 text-white text-sm font-medium rounded-xl shadow-soft hover:bg-neutral-700 transition-colors"
          tabindex="0"
          aria-label="View more projects"
        >
          <svg
            class="w-4 h-4"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
          </svg>
          More projects
        </a>
        <a
          href="/contact"
          class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-accent-600 text-white text-sm font-medium rounded-xl shadow-accent hover:bg-accent-700 transition-colors"
          tabindex="0"
          aria-label="Get in touch"
        >
          Work with me
          <svg
            class="w-4 h-4"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
          </svg>
        </a>
      </div>
    </article>
  </main>
  <Footer compact />
</Layout>
