---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { getCollection, render } from "astro:content";

export const getStaticPaths = async () => {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: {
      slug:
        post.data.slug || post.id.split("/").pop()?.replace(".md", "") || "",
    },
    props: { post },
  }));
};

interface Props {
  post: Awaited<ReturnType<typeof getCollection<"blog">>>[number];
}

const { post } = Astro.props;
const { Content } = await render(post);

// Format date for display
const formatDate = (dateString: string | Date): string => {
  const date =
    typeof dateString === "string" ? new Date(dateString) : dateString;
  return date.toLocaleDateString("en-US", { month: "short", year: "numeric" });
};

const displayDate = formatDate(post.data.publishedAt);
---

<Layout
  title={`${post.data.title} | Antonis Skandalis`}
  description={post.data.excerpt}
  type="article"
  publishedTime={new Date(post.data.publishedAt).toISOString()}
  author="Antonis Skandalis"
  image={post.data.image ? `/blog-assets/${post.data.image}` : undefined}
  imageAlt={post.data.title}
>
  <Header />
  <main id="main-content" class="min-h-screen bg-neutral-50 dark:bg-neutral-900" role="main">
    <nav
      class="bg-neutral-50 dark:bg-neutral-900 border-b border-neutral-200/80 dark:border-neutral-700/80"
    >
      <div class="max-w-4xl mx-auto px-4 sm:px-6 py-4">
        <a
          href="/blog"
          class="inline-flex items-center gap-2 text-sm font-medium text-neutral-600 dark:text-neutral-400 hover:text-neutral-900 dark:hover:text-neutral-100 transition-colors"
          tabindex="0"
          aria-label="Back to blog"
        >
          <svg
            class="w-4 h-4"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
          </svg>
          Back to Blog
        </a>
      </div>
    </nav>

    <article class="max-w-4xl mx-auto px-6 py-16">
      <div class="mb-8">
        <span
          class="text-xs font-medium text-neutral-500 dark:text-neutral-400 mb-4 inline-block"
        >
          {displayDate}
        </span>
        <h1
          class="text-2xl sm:text-3xl font-semibold text-neutral-900 dark:text-neutral-100 mb-6 leading-tight"
        >
          {post.data.title}
        </h1>
        <p
          class="text-neutral-600 dark:text-neutral-400 text-base leading-relaxed border-l-2 border-neutral-200 dark:border-neutral-600 pl-4"
        >
          {post.data.excerpt}
        </p>
      </div>

      <div
        class="bg-white dark:bg-neutral-800 rounded-2xl p-8 shadow-soft border border-transparent dark:border-neutral-700"
      >
        <div
          class="blog-prose prose prose-neutral dark:prose-invert prose-lg max-w-none space-y-6 [&_h2]:underline [&_pre]:!bg-neutral-800 [&_pre]:!text-neutral-100 [&_pre]:border [&_pre]:border-neutral-700 dark:[&_pre]:!bg-neutral-800 dark:[&_pre]:!text-neutral-100 dark:[&_pre]:border-neutral-700 [&_pre]:rounded-lg [&_pre]:p-6 [&_pre]:overflow-x-auto [&_pre]:my-6 [&_code]:px-1.5 [&_code]:py-0.5 [&_code]:font-mono [&_code]:text-sm [&_code]:!bg-neutral-800 [&_code]:!text-neutral-100 dark:[&_code]:!bg-neutral-100 dark:[&_code]:!text-neutral-900 dark:[&_pre_code]:!bg-transparent dark:[&_pre_code]:!text-neutral-100 [&_code]:rounded [&_img]:rounded-lg [&_img]:border [&_img]:border-neutral-200 dark:[&_img]:border-neutral-600"
        >
          <Content />
        </div>
      </div>

      <div class="mt-12 text-center">
        <a
          href="/blog"
          class="inline-flex items-center gap-2 px-6 py-3 bg-accent-600 text-white text-sm font-medium rounded-xl ring-0 shadow-none hover:bg-accent-700 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-neutral-500"
          aria-label="Read more articles"
        >
          <svg
            class="w-5 h-5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
          </svg>
          More articles
        </a>
      </div>
    </article>
  </main>
  <Footer compact />
</Layout>

<style is:global>
  /* Code selection - blog post only, higher specificity */
  .blog-prose pre::selection,
  .blog-prose code::selection,
  .blog-prose pre::-moz-selection,
  .blog-prose code::-moz-selection,
  .blog-prose pre::-webkit-selection,
  .blog-prose code::-webkit-selection {
    background-color: rgb(82 82 82) !important;
    color: rgb(255 255 255) !important;
  }

  .dark .blog-prose pre::selection,
  .dark .blog-prose pre code::selection,
  .dark .blog-prose pre::-moz-selection,
  .dark .blog-prose pre code::-moz-selection,
  .dark .blog-prose pre::-webkit-selection,
  .dark .blog-prose pre code::-webkit-selection {
    background-color: rgb(82 82 82) !important;
    color: rgb(255 255 255) !important;
  }

  .dark .blog-prose code:not(pre code)::selection,
  .dark .blog-prose code:not(pre code)::-moz-selection,
  .dark .blog-prose code:not(pre code)::-webkit-selection {
    background-color: rgb(212 212 212) !important;
    color: rgb(23 23 23) !important;
  }
</style>
