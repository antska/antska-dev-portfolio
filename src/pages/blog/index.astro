---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { PAGE_TITLES, META_DESCRIPTIONS } from "../../lib/constants";
import { getCollection } from "astro:content";

// Fetch posts from Content Collections
const posts = (await getCollection("blog")).sort((a, b) => {
  const dateA =
    typeof a.data.publishedAt === "string"
      ? new Date(a.data.publishedAt)
      : a.data.publishedAt;
  const dateB =
    typeof b.data.publishedAt === "string"
      ? new Date(b.data.publishedAt)
      : b.data.publishedAt;
  return dateB.getTime() - dateA.getTime();
});

// Format date for display
const formatDate = (dateString: string | Date): string => {
  const date =
    typeof dateString === "string" ? new Date(dateString) : dateString;
  return date.toLocaleDateString("en-US", { month: "short", year: "numeric" });
};
---

<Layout title={PAGE_TITLES.blog} description={META_DESCRIPTIONS.blog}>
  <Header />
  <main class="min-h-screen bg-neutral-50 dark:bg-neutral-900">
    <section class="py-24">
      <div class="max-w-3xl mx-auto px-6">
        <p
          class="text-xs font-medium uppercase tracking-widest text-neutral-500 dark:text-neutral-400 text-center mb-2"
        >
          Blog
        </p>
        <h1
          class="text-2xl font-semibold text-neutral-900 dark:text-neutral-100 mb-16 text-center"
        >
          Technical articles
        </h1>

        <div class="grid gap-8">
          {
            posts.map((post) => {
              const displayDate = formatDate(post.data.publishedAt);
              const slug =
                post.data.slug ??
                post.id.split("/").pop()?.replace(/\.md$/, "") ??
                "";
              return (
                <article class="bg-white dark:bg-neutral-800 rounded-2xl p-8 shadow-soft hover:shadow-soft-md transition-shadow cursor-pointer group border border-transparent dark:border-neutral-700">
                  <a
                    href={`/blog/${slug}`}
                    class="block"
                    tabindex="0"
                    aria-label={`Read article: ${post.data.title}`}
                  >
                    <div class="flex flex-wrap items-center gap-4 mb-4">
                      <h2 class="text-xl font-semibold text-neutral-900 dark:text-neutral-100 flex-1 group-hover:text-neutral-700 dark:group-hover:text-neutral-300">
                        {post.data.title}
                      </h2>
                      <span class="text-xs font-medium text-neutral-500 dark:text-neutral-400">
                        {displayDate}
                      </span>
                    </div>

                    <p class="text-neutral-600 dark:text-neutral-400 text-sm leading-relaxed mb-4 border-l-2 border-neutral-200 dark:border-neutral-600 pl-4">
                      {post.data.excerpt}
                    </p>

                    <div class="flex items-center gap-2 text-sm font-medium text-neutral-500 dark:text-neutral-400 group-hover:text-neutral-700 dark:group-hover:text-neutral-200 transition-colors mt-6">
                      Read article
                      <svg
                        class="w-4 h-4 group-hover:translate-x-0.5 transition-transform"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M17 8l4 4m0 0l-4 4m4-4H3"
                        />
                      </svg>
                    </div>
                  </a>
                </article>
              );
            })
          }
        </div>
      </div>
    </section>
  </main>
  <Footer compact />
</Layout>
