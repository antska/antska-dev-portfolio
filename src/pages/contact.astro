---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { PAGE_TITLES, META_DESCRIPTIONS } from "../lib/constants";
---

<Layout title={PAGE_TITLES.contact} description={META_DESCRIPTIONS.contact}>
  <Header />
  <main
    id="main-content"
    class="min-h-screen bg-neutral-50 dark:bg-neutral-900"
    role="main"
  >
    <section class="py-24">
      <div class="max-w-2xl mx-auto px-6">
        <p
          class="text-xs font-medium uppercase tracking-widest text-neutral-500 dark:text-neutral-400 text-center mb-2"
        >
          Contact
        </p>
        <h1
          class="text-2xl font-semibold text-neutral-900 dark:text-neutral-100 mb-2 text-center"
        >
          Get in touch
        </h1>
        <p class="text-base text-neutral-500 dark:text-neutral-400 text-center">
          Web developer in Paros, Greece
        </p>
        <p
          class="text-base text-neutral-500 dark:text-neutral-400 text-center mb-16"
        >
          Get in touch for websites, web apps, or custom software
        </p>

        <div
          class="bg-white dark:bg-neutral-800 rounded-2xl p-8 shadow-soft hover:shadow-soft-lg hover:-translate-y-0.5 transition-all duration-200 ease-out border border-transparent dark:border-neutral-700"
        >
          <form
            class="space-y-6"
            action="/contact/"
            method="POST"
            id="contact-form"
            name="contact-form"
            data-netlify="true"
            netlify-honeypot="bot-field"
          >
            <input type="hidden" name="form-name" value="contact-form" />
            <p class="hidden" aria-hidden="true">
              <label for="contact-bot">Leave this empty</label>
              <input
                type="text"
                id="contact-bot"
                name="bot-field"
                tabindex="-1"
                autocomplete="off"
              />
            </p>
            <div>
              <label
                for="name"
                class="block font-medium text-neutral-700 dark:text-neutral-300 mb-2 text-sm"
              >
                Name
              </label>
              <input
                type="text"
                id="name"
                name="name"
                required
                autocomplete="name"
                class="w-full bg-white dark:bg-neutral-800 border border-neutral-200 dark:border-neutral-600 rounded-lg px-4 py-3 text-neutral-800 dark:text-neutral-100 placeholder:text-neutral-400 dark:placeholder:text-neutral-500 focus:outline-none focus:ring-2 focus:ring-neutral-200 dark:focus:ring-neutral-600 focus:border-neutral-300 dark:focus:border-neutral-500 transition-colors"
                placeholder="Your name"
              />
            </div>

            <div>
              <label
                for="email"
                class="block font-medium text-neutral-700 dark:text-neutral-300 mb-2 text-sm"
              >
                Email
              </label>
              <input
                type="email"
                id="email"
                name="email"
                required
                autocomplete="email"
                class="w-full bg-white dark:bg-neutral-800 border border-neutral-200 dark:border-neutral-600 rounded-lg px-4 py-3 text-neutral-800 dark:text-neutral-100 placeholder:text-neutral-400 dark:placeholder:text-neutral-500 focus:outline-none focus:ring-2 focus:ring-neutral-200 dark:focus:ring-neutral-600 focus:border-neutral-300 dark:focus:border-neutral-500 transition-colors"
                placeholder="your@email.com"
              />
            </div>

            <div>
              <label
                for="message"
                class="block font-medium text-neutral-700 dark:text-neutral-300 mb-2 text-sm"
              >
                Message
              </label>
              <textarea
                id="message"
                name="message"
                rows="6"
                required
                class="w-full bg-white dark:bg-neutral-800 border border-neutral-200 dark:border-neutral-600 rounded-lg px-4 py-3 text-neutral-800 dark:text-neutral-100 placeholder:text-neutral-400 dark:placeholder:text-neutral-500 focus:outline-none focus:ring-2 focus:ring-neutral-200 dark:focus:ring-neutral-600 focus:border-neutral-300 dark:focus:border-neutral-500 transition-colors resize-none"
                placeholder="What's on your mind? Tell me about your project, idea, or just say hello..."
              ></textarea>
            </div>

            <button
              type="submit"
              class="w-full bg-accent-600 text-white px-6 py-3 font-medium text-sm rounded-xl hover:bg-accent-700 transition-colors flex items-center justify-center gap-2 focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-neutral-500"
              aria-label="Send message"
            >
              Send Message
              <svg
                class="w-4 h-4"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
              </svg>
            </button>
          </form>
        </div>

        <div class="mt-12 text-center">
          <p class="text-neutral-600 dark:text-neutral-400 text-sm mb-2">
            Prefer email? Drop me a line at
          </p>
          <p class="text-neutral-900 dark:text-neutral-100 font-medium">
            <a
              href="mailto:ant.skandalis@gmail.com"
              class="underline decoration-4 hover:bg-neutral-200 dark:hover:bg-neutral-700 transition-colors text-xl focus:outline-none focus-visible:ring-2 focus-visible:ring-neutral-500 focus-visible:ring-offset-2 rounded"
              aria-label="Send email to ant.skandalis@gmail.com"
            >
              ant.skandalis@gmail.com
            </a>
          </p>
          <p class="text-neutral-500 dark:text-neutral-400 mt-4 text-sm">
            I usually respond within 24 hours. Unless I'm deep in a debugging
            session—then it might take a bit longer.
          </p>
        </div>

        <!-- Social Links -->
        <div class="mt-12 flex justify-center gap-4">
          <a
            href="https://github.com/antska"
            target="_blank"
            rel="noopener noreferrer"
            class="p-2.5 rounded-lg text-neutral-500 dark:text-neutral-400 hover:text-neutral-900 dark:hover:text-neutral-100 hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors"
            aria-label="Visit GitHub profile"
            tabindex="0"
          >
            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
              <path
                d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"
              ></path>
            </svg>
          </a>
          <a
            href="https://linkedin.com/in/antskandalis"
            target="_blank"
            rel="noopener noreferrer"
            class="p-2.5 rounded-lg text-neutral-500 dark:text-neutral-400 hover:text-neutral-900 dark:hover:text-neutral-100 hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors"
            aria-label="Visit LinkedIn profile"
            tabindex="0"
          >
            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
              <path
                d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
              ></path>
            </svg>
          </a>
          <a
            href="mailto:ant.skandalis@gmail.com"
            class="p-2.5 rounded-lg text-neutral-500 dark:text-neutral-400 hover:text-neutral-900 dark:hover:text-neutral-100 hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors"
            aria-label="Send email"
            tabindex="0"
          >
            <svg
              class="w-6 h-6"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
              ></path>
            </svg>
          </a>
        </div>
      </div>
    </section>
  </main>
  <Footer compact />
</Layout>

<script>
  const showSuccessBanner = () => {
    const banner = document.createElement("div");
    banner.setAttribute("role", "status");
    banner.setAttribute("aria-live", "polite");
    banner.className =
      "mb-6 rounded-xl bg-accent-50 dark:bg-accent-900/20 border border-accent-200 dark:border-accent-800 px-6 py-4 text-accent-800 dark:text-accent-200 text-sm font-medium";
    banner.textContent = "Thanks for reaching out! I'll get back to you soon.";
    const form = document.getElementById("contact-form");
    form?.insertAdjacentElement("beforebegin", banner);
  };

  // Show thank-you message when URL has #success (e.g. after JS submit redirect)
  const hash = typeof window !== "undefined" ? window.location.hash : "";
  if (hash === "#success") {
    showSuccessBanner();
    history.replaceState(null, "", window.location.pathname);
  }

  // Submit via fetch so we can redirect to #success (hash is never sent in POST, so Netlify redirect drops it)
  const contactForm = document.getElementById(
    "contact-form"
  ) as HTMLFormElement | null;
  if (contactForm) {
    contactForm.addEventListener("submit", async (e) => {
      e.preventDefault();
      const submitButton = contactForm.querySelector('button[type="submit"]');
      const originalText = submitButton?.textContent ?? "";
      try {
        if (submitButton) {
          submitButton.setAttribute("disabled", "true");
          submitButton.textContent = "Sending…";
        }
        const formData = new FormData(contactForm);
        const response = await fetch("/contact/", {
          method: "POST",
          body: formData,
        });
        if (response.ok) {
          window.location.href = "/contact/#success";
          return;
        }
        throw new Error("Form submission failed");
      } catch {
        if (submitButton) {
          submitButton.removeAttribute("disabled");
          submitButton.textContent = originalText;
        }
        const banner = document.createElement("div");
        banner.setAttribute("role", "alert");
        banner.className =
          "mb-6 rounded-xl bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 px-6 py-4 text-red-800 dark:text-red-200 text-sm font-medium";
        banner.textContent =
          "Something went wrong. Please try again or email me directly.";
        contactForm.insertAdjacentElement("beforebegin", banner);
      }
    });
  }
</script>
