---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Footer from "../components/Footer.astro";
import {
  HERO_DESCRIPTION,
  NAVIGATION_CARDS,
  PAGE_TITLES,
  META_DESCRIPTIONS,
} from "../lib/constants";

const heroDescription = HERO_DESCRIPTION;
---

<Layout title={PAGE_TITLES.home} description={META_DESCRIPTIONS.home} isHomepage>
  <div
    class="min-h-screen flex flex-col overflow-auto bg-neutral-50 dark:bg-neutral-900"
  >
    <Header />
    <main id="main-content" class="flex-1 min-h-0 flex flex-col overflow-auto" role="main">
      <Hero description={heroDescription} />

      <!-- Explore: closer to hero, fits in viewport -->
      <section
        class="flex-1 min-h-0 flex flex-col items-center justify-center px-3 py-1 pb-6 sm:py-2 sm:pb-2 bg-neutral-50 dark:bg-neutral-900"
      >
        <p
          class="text-[10px] sm:text-xs font-medium uppercase tracking-widest text-neutral-500 dark:text-neutral-400 text-center mb-0.5"
        >
          Explore
        </p>
        <h2
          class="text-base sm:text-lg font-semibold text-neutral-900 dark:text-neutral-100 mb-2 sm:mb-3 text-center"
        >
          What I do & where to find me
        </h2>

        <div
          class="grid grid-cols-2 lg:grid-cols-4 gap-2 sm:gap-3 w-full max-w-5xl mx-auto flex-1 min-h-0 content-center"
        >
          <!-- About Card -->
          <a
            href={NAVIGATION_CARDS.about.href}
            class="bg-white dark:bg-neutral-800 rounded-xl sm:rounded-2xl p-4 sm:p-6 shadow-soft hover:shadow-soft-lg hover:-translate-y-1 transition-all duration-200 ease-out group border border-transparent dark:border-neutral-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-neutral-500 focus-visible:ring-offset-2"
            aria-label="Learn more about me"
          >
            <div
              class="text-2xl sm:text-3xl mb-2 sm:mb-3 text-neutral-400 dark:text-neutral-500 group-hover:text-neutral-600 dark:group-hover:text-neutral-300 transition-colors"
            >
              {NAVIGATION_CARDS.about.icon}
            </div>
            <h3
              class="text-base sm:text-lg font-semibold text-neutral-900 dark:text-neutral-100 mb-1 sm:mb-2 group-hover:text-neutral-700 dark:group-hover:text-neutral-300 transition-colors"
            >
              {NAVIGATION_CARDS.about.title}
            </h3>
            <p
              class="text-neutral-600 dark:text-neutral-400 text-xs sm:text-sm leading-snug mb-2 sm:mb-3 line-clamp-2"
            >
              {NAVIGATION_CARDS.about.description}
            </p>
            <div
              class="flex items-center gap-1.5 text-xs sm:text-sm font-medium text-neutral-500 dark:text-neutral-400 group-hover:text-neutral-700 dark:group-hover:text-neutral-200 transition-colors"
            >
              {NAVIGATION_CARDS.about.label}
              <svg
                class="w-3.5 h-3.5 group-hover:translate-x-0.5 transition-transform"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
              </svg>
            </div>
          </a>

          <!-- Projects Card -->
          <a
            href={NAVIGATION_CARDS.projects.href}
            class="bg-white dark:bg-neutral-800 rounded-xl sm:rounded-2xl p-4 sm:p-6 shadow-soft hover:shadow-soft-lg hover:-translate-y-1 transition-all duration-200 ease-out group border border-transparent dark:border-neutral-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-neutral-500 focus-visible:ring-offset-2"
            aria-label="View my projects"
          >
            <div
              class="text-2xl sm:text-3xl mb-2 sm:mb-3 text-neutral-400 dark:text-neutral-500 group-hover:text-neutral-600 dark:group-hover:text-neutral-300 transition-colors"
            >
              {NAVIGATION_CARDS.projects.icon}
            </div>
            <h3
              class="text-base sm:text-lg font-semibold text-neutral-900 dark:text-neutral-100 mb-1 sm:mb-2 group-hover:text-neutral-700 dark:group-hover:text-neutral-300 transition-colors"
            >
              {NAVIGATION_CARDS.projects.title}
            </h3>
            <p
              class="text-neutral-600 dark:text-neutral-400 text-xs sm:text-sm leading-snug mb-2 sm:mb-3 line-clamp-2"
            >
              {NAVIGATION_CARDS.projects.description}
            </p>
            <div
              class="flex items-center gap-1.5 text-xs sm:text-sm font-medium text-neutral-500 dark:text-neutral-400 group-hover:text-neutral-700 dark:group-hover:text-neutral-200 transition-colors"
            >
              {NAVIGATION_CARDS.projects.label}
              <svg
                class="w-3.5 h-3.5 group-hover:translate-x-0.5 transition-transform"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
              </svg>
            </div>
          </a>

          <!-- Blog Card -->
          <a
            href={NAVIGATION_CARDS.blog.href}
            class="bg-white dark:bg-neutral-800 rounded-xl sm:rounded-2xl p-4 sm:p-6 shadow-soft hover:shadow-soft-lg hover:-translate-y-1 transition-all duration-200 ease-out group border border-transparent dark:border-neutral-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-neutral-500 focus-visible:ring-offset-2"
            aria-label="Read my blog"
          >
            <div
              class="text-2xl sm:text-3xl mb-2 sm:mb-3 text-neutral-400 dark:text-neutral-500 group-hover:text-neutral-600 dark:group-hover:text-neutral-300 transition-colors"
            >
              {NAVIGATION_CARDS.blog.icon}
            </div>
            <h3
              class="text-base sm:text-lg font-semibold text-neutral-900 dark:text-neutral-100 mb-1 sm:mb-2 group-hover:text-neutral-700 dark:group-hover:text-neutral-300 transition-colors"
            >
              {NAVIGATION_CARDS.blog.title}
            </h3>
            <p
              class="text-neutral-600 dark:text-neutral-400 text-xs sm:text-sm leading-snug mb-2 sm:mb-3 line-clamp-2"
            >
              {NAVIGATION_CARDS.blog.description}
            </p>
            <div
              class="flex items-center gap-1.5 text-xs sm:text-sm font-medium text-neutral-500 dark:text-neutral-400 group-hover:text-neutral-700 dark:group-hover:text-neutral-200 transition-colors"
            >
              {NAVIGATION_CARDS.blog.label}
              <svg
                class="w-3.5 h-3.5 group-hover:translate-x-0.5 transition-transform"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
              </svg>
            </div>
          </a>

          <!-- Contact Card -->
          <a
            href={NAVIGATION_CARDS.contact.href}
            class="bg-white dark:bg-neutral-800 rounded-xl sm:rounded-2xl p-4 sm:p-6 shadow-soft hover:shadow-soft-lg hover:-translate-y-1 transition-all duration-200 ease-out group border border-transparent dark:border-neutral-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-neutral-500 focus-visible:ring-offset-2"
            aria-label="Get in touch"
          >
            <div
              class="text-2xl sm:text-3xl mb-2 sm:mb-3 text-neutral-400 dark:text-neutral-500 group-hover:text-neutral-600 dark:group-hover:text-neutral-300 transition-colors"
            >
              {NAVIGATION_CARDS.contact.icon}
            </div>
            <h3
              class="text-base sm:text-lg font-semibold text-neutral-900 dark:text-neutral-100 mb-1 sm:mb-2 group-hover:text-neutral-700 dark:group-hover:text-neutral-300 transition-colors"
            >
              {NAVIGATION_CARDS.contact.title}
            </h3>
            <p
              class="text-neutral-600 dark:text-neutral-400 text-xs sm:text-sm leading-snug mb-2 sm:mb-3 line-clamp-2"
            >
              {NAVIGATION_CARDS.contact.description}
            </p>
            <div
              class="flex items-center gap-1.5 text-xs sm:text-sm font-medium text-neutral-500 dark:text-neutral-400 group-hover:text-neutral-700 dark:group-hover:text-neutral-200 transition-colors"
            >
              {NAVIGATION_CARDS.contact.label}
              <svg
                class="w-3.5 h-3.5 group-hover:translate-x-0.5 transition-transform"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
              </svg>
            </div>
          </a>
        </div>
      </section>
      <Footer compact />
    </main>
  </div>
</Layout>
