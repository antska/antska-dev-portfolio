---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { getCollection } from "astro:content";
import { PAGE_TITLES, META_DESCRIPTIONS } from "../lib/constants";

// Fetch projects from Content Collections, ordered by order field (1 first)
const projects = (await getCollection("projects")).sort((a, b) => {
  const orderA = a.data.order ?? 999;
  const orderB = b.data.order ?? 999;
  return orderA - orderB;
});
---

<Layout title={PAGE_TITLES.projects} description={META_DESCRIPTIONS.projects}>
  <Header />
  <main class="min-h-screen bg-neutral-50 dark:bg-neutral-900">
    <section class="py-24">
      <div class="max-w-4xl mx-auto px-6">
        <p
          class="text-xs font-medium uppercase tracking-widest text-neutral-500 dark:text-neutral-400 text-center mb-2"
        >
          Projects
        </p>
        <h1
          class="text-2xl font-semibold text-neutral-900 dark:text-neutral-100 mb-16 text-center"
        >
          Featured projects
        </h1>

        <div class="grid md:grid-cols-2 gap-8">
          {
            projects.map((project) => {
              const href = project.data.website || "#";
              const isExternal = Boolean(project.data.website);
              return (
                <article class="bg-white dark:bg-neutral-800 rounded-2xl p-8 shadow-soft hover:shadow-soft-lg hover:-translate-y-1 transition-all duration-200 ease-out group overflow-hidden relative border border-transparent dark:border-neutral-700">
                  <a
                    href={href}
                    class="block"
                    tabindex="0"
                    aria-label={
                      isExternal
                        ? `Visit website: ${project.data.title}`
                        : `Project: ${project.data.title}`
                    }
                    {...(isExternal
                      ? { target: "_blank", rel: "noopener noreferrer" }
                      : {})}
                  >
                    <div class="flex items-start justify-between mb-4 gap-3">
                      <div class="flex-1 min-w-0">
                        <h2 class="text-xl font-semibold text-neutral-900 dark:text-neutral-100 leading-tight group-hover:text-neutral-700 dark:group-hover:text-neutral-300">
                          {project.data.title}
                        </h2>
                        {project.data.inProgress && (
                          <div
                            class="inline-flex items-center gap-1.5 mt-2 text-xs font-medium text-amber-700 dark:text-amber-400"
                            aria-label="Project in progress"
                          >
                            <span class="relative flex h-1.5 w-1.5">
                              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-amber-400 opacity-75" />
                              <span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-amber-500" />
                            </span>
                            In progress
                          </div>
                        )}
                      </div>
                      {isExternal && (
                        <span
                          class="flex-shrink-0 p-1.5 rounded-lg text-neutral-400 dark:text-neutral-500 group-hover:text-neutral-600 dark:group-hover:text-neutral-300 group-hover:bg-neutral-50 dark:group-hover:bg-neutral-700 transition-colors"
                          aria-hidden="true"
                        >
                          <svg
                            class="w-5 h-5"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                          >
                            <path
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              stroke-width="2"
                              d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                            />
                          </svg>
                        </span>
                      )}
                    </div>

                    <p class="text-neutral-600 dark:text-neutral-400 text-sm leading-relaxed mb-6">
                      {project.data.description}
                    </p>

                    {project.data.tags && project.data.tags.length > 0 && (
                      <div class="flex flex-wrap gap-2 mb-6">
                        {project.data.tags.slice(0, 6).map((tag) => (
                          <span class="px-3 py-1.5 bg-neutral-50 dark:bg-neutral-700 border border-neutral-200 dark:border-neutral-600 rounded-lg font-medium text-xs text-neutral-600 dark:text-neutral-300">
                            {tag}
                          </span>
                        ))}
                      </div>
                    )}

                    {project.data.highlights &&
                      project.data.highlights.length > 0 && (
                        <ul class="space-y-2">
                          {project.data.highlights
                            .slice(0, 3)
                            .map((highlight) => (
                              <li class="text-sm flex items-center gap-2 text-neutral-600 dark:text-neutral-400">
                                <span class="text-neutral-400 dark:text-neutral-500">
                                  →
                                </span>
                                {highlight}
                              </li>
                            ))}
                        </ul>
                      )}
                  </a>
                </article>
              );
            })
          }
        </div>
      </div>
    </section>
  </main>
  <Footer compact />
</Layout>
