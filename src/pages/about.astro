---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { getCollection, getEntry } from "astro:content";
import { PAGE_TITLES, META_DESCRIPTIONS, VALUES } from "../lib/constants";

// Fetch data from Content Collections
const about = await getEntry("about", "about");
const skills = await getCollection("skills");
const experiences = await getCollection("experience");

// Sort skills by order
const sortedSkills = [...skills].sort(
  (a, b) => (a.data.order || 0) - (b.data.order || 0),
);

// Sort experiences by order
const sortedExperiences = [...experiences].sort((a, b) => {
  if (a.data.order !== b.data.order) {
    return (a.data.order || 0) - (b.data.order || 0);
  }
  const dateA = new Date(a.data.startDate);
  const dateB = new Date(b.data.startDate);
  return dateB.getTime() - dateA.getTime();
});

// Format date helper
const formatDate = (dateString: string) => {
  const date = new Date(dateString);
  return date.toLocaleDateString("en-US", {
    month: "2-digit",
    year: "numeric",
  });
};

const formatPeriod = (
  startDate: string,
  endDate?: string,
  isCurrent?: boolean,
) => {
  const start = formatDate(startDate);
  const end = isCurrent ? "Present" : endDate ? formatDate(endDate) : "";
  return `${start} - ${end}`;
};

const backgroundParagraphs = about?.data.backgroundParagraphs ?? [];
---

<Layout title={PAGE_TITLES.about} description={META_DESCRIPTIONS.about}>
  <Header />
  <main>
    <section class="min-h-screen py-24 bg-neutral-50 dark:bg-neutral-900">
      <div class="max-w-6xl mx-auto px-6">
        <p
          class="text-xs font-medium uppercase tracking-widest text-neutral-500 dark:text-neutral-400 text-center mb-2"
        >
          About me
        </p>
        <h1
          class="text-3xl md:text-4xl font-semibold text-neutral-900 dark:text-neutral-100 mb-16 text-center"
        >
          Introduction about myself
        </h1>

        <div class="grid md:grid-cols-2 gap-8">
          <!-- Background Card -->
          <div
            class="bg-white dark:bg-neutral-800 rounded-2xl p-8 shadow-soft hover:shadow-soft-lg hover:-translate-y-0.5 transition-all duration-200 ease-out border border-transparent dark:border-neutral-700"
          >
            <h2
              class="text-xl font-semibold text-neutral-900 dark:text-neutral-100 mb-6"
            >
              Background
            </h2>
            {
              backgroundParagraphs.map((paragraph, idx) => (
                <p
                  class={`text-neutral-600 dark:text-neutral-400 leading-relaxed text-base ${idx < backgroundParagraphs.length - 1 ? "mb-6" : ""}`}
                  set:html={paragraph}
                />
              ))
            }
          </div>

          <!-- Skills Card -->
          <div
            class="bg-white dark:bg-neutral-800 rounded-2xl p-8 shadow-soft hover:shadow-soft-lg hover:-translate-y-0.5 transition-all duration-200 ease-out border border-transparent dark:border-neutral-700"
          >
            <p
              class="text-xs font-medium uppercase tracking-widest text-neutral-500 dark:text-neutral-400 mb-2"
            >
              Skills
            </p>
            <h2
              class="text-xl font-semibold text-neutral-900 dark:text-neutral-100 mb-6"
            >
              Core skills
            </h2>

            <div class="flex flex-wrap gap-2" id="skills-container">
              {
                sortedSkills.map((skill, idx) => {
                  const isHidden = idx >= 12;
                  return (
                    <span
                      class={`px-3 py-1.5 bg-neutral-50 dark:bg-neutral-700/50 border border-neutral-200 dark:border-neutral-600 rounded-lg text-sm font-medium text-neutral-700 dark:text-neutral-300 ${isHidden ? "hidden md:!inline-block" : ""}`}
                      data-skill-index={idx}
                      id={isHidden ? undefined : `skill-${idx}`}
                    >
                      {skill.data.name}
                    </span>
                  );
                })
              }
            </div>

            {
              sortedSkills.length > 12 && (
                <button
                  id="show-more-skills"
                  type="button"
                  aria-expanded="false"
                  class="md:hidden mt-6 w-full px-4 py-3 bg-neutral-50 dark:bg-neutral-700/50 border border-neutral-200 dark:border-neutral-600 rounded-xl text-sm font-medium text-neutral-600 dark:text-neutral-300 hover:bg-neutral-100 dark:hover:bg-neutral-700 transition-colors"
                  aria-label="Show more skills"
                >
                  Show more skills
                </button>
              )
            }
          </div>
        </div>

        <!-- Experience Section -->
        <div class="mt-16">
          <p
            class="text-xs font-medium uppercase tracking-widest text-neutral-500 dark:text-neutral-400 text-center mb-2"
          >
            Experience
          </p>
          <h2
            class="text-2xl font-semibold text-neutral-900 dark:text-neutral-100 mb-8 text-center"
          >
            Work experience
          </h2>

          <div class="space-y-6">
            {
              sortedExperiences.map((exp) => (
                <div class="bg-white dark:bg-neutral-800 rounded-2xl p-6 shadow-soft hover:shadow-soft-lg hover:-translate-y-0.5 transition-all duration-200 ease-out border border-transparent dark:border-neutral-700">
                  <div class="flex flex-wrap justify-between items-start mb-3 gap-4">
                    <div>
                      <h3 class="text-lg font-semibold text-neutral-900 dark:text-neutral-100">
                        {exp.data.title}
                      </h3>
                      <p class="text-neutral-600 dark:text-neutral-400 text-sm mt-1">
                        {exp.data.company}
                        {exp.data.location && ` · ${exp.data.location}`}
                      </p>
                    </div>
                    <span class="text-xs font-medium text-neutral-500 dark:text-neutral-400 bg-neutral-100 dark:bg-neutral-700 px-3 py-1.5 rounded-full">
                      {formatPeriod(
                        exp.data.startDate,
                        exp.data.endDate,
                        exp.data.isCurrent,
                      )}
                    </span>
                  </div>
                  <p class="text-neutral-600 dark:text-neutral-400 text-sm leading-relaxed mb-3">
                    {exp.data.description}
                  </p>
                  {exp.data.achievements &&
                    exp.data.achievements.length > 0 && (
                      <ul class="space-y-2 mt-4">
                        {exp.data.achievements
                          .slice(0, 3)
                          .map((achievement) => (
                            <li class="text-sm flex items-start gap-2 text-neutral-600 dark:text-neutral-400">
                              <span class="text-neutral-400 dark:text-neutral-500 mt-0.5">
                                →
                              </span>
                              <span>{achievement}</span>
                            </li>
                          ))}
                      </ul>
                    )}
                  {exp.data.technologies &&
                    exp.data.technologies.length > 0 && (
                      <div class="flex flex-wrap gap-2 mt-4">
                        {exp.data.technologies.slice(0, 5).map((tech) => (
                          <span class="px-2.5 py-1 bg-neutral-100 dark:bg-neutral-700 border border-neutral-200 dark:border-neutral-600 rounded-md font-medium text-xs text-neutral-600 dark:text-neutral-300">
                            {tech}
                          </span>
                        ))}
                      </div>
                    )}
                </div>
              ))
            }
          </div>
        </div>

        <!-- Values  -->
        <div class="mt-16">
          <p
            class="text-xs font-medium uppercase tracking-widest text-neutral-500 dark:text-neutral-400 text-center mb-2"
          >
            Values
          </p>
          <h2
            class="text-2xl font-semibold text-neutral-900 dark:text-neutral-100 mb-4 text-center"
          >
            What resonates with me
          </h2>
          <ul class="space-y-4 max-w-3xl mx-auto">
            {
              VALUES.map((value) => (
                <li class="bg-white dark:bg-neutral-800 rounded-2xl p-6 shadow-soft hover:shadow-soft-lg hover:-translate-y-0.5 transition-all duration-200 ease-out border border-transparent dark:border-neutral-700">
                  <h3 class="text-base font-semibold text-neutral-900 dark:text-neutral-100 mb-2">
                    {value.title}
                  </h3>
                  <p class="text-neutral-600 dark:text-neutral-400 text-sm leading-relaxed">
                    {value.description}
                  </p>
                </li>
              ))
            }
          </ul>
        </div>

        <!-- CTA -->
        <div class="mt-16 text-center">
          <p
            class="text-xs font-medium uppercase tracking-widest text-neutral-500 dark:text-neutral-400 mb-2"
          >
            Contact
          </p>
          <h2
            class="text-2xl font-semibold text-neutral-900 dark:text-neutral-100 mb-6"
          >
            Let's make your idea happen.
          </h2>
          <a
            href="/contact"
            class="inline-flex items-center gap-2 px-6 py-3 bg-accent-600 text-white text-sm font-semibold rounded-xl shadow-accent hover:bg-accent-700 transition-colors"
            tabindex="0"
            aria-label="Get in touch"
          >
            Let's Work Together
            <svg
              class="w-4 h-4"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
            </svg>
          </a>
        </div>
      </div>
    </section>
  </main>
  <Footer compact />
</Layout>

<script>
  // Event delegation so show more works after View Transitions
  document.addEventListener("click", (e) => {
    const btn = (e.target as Element)?.closest?.("#show-more-skills");
    if (!btn) return;
    const skillsContainer = document.getElementById("skills-container");
    if (!skillsContainer) return;

    const hiddenSkills = skillsContainer.querySelectorAll("[data-skill-index]");
    const isExpanded = btn.getAttribute("aria-expanded") === "true";

    hiddenSkills.forEach((skillEl) => {
      const index = parseInt(skillEl.getAttribute("data-skill-index") || "0");
      if (index >= 12) {
        if (isExpanded) {
          skillEl.classList.add("hidden");
        } else {
          skillEl.classList.remove("hidden");
        }
      }
    });

    btn.setAttribute("aria-expanded", (!isExpanded).toString());
    btn.textContent = isExpanded ? "Show more skills" : "Show less skills";
  });
</script>
